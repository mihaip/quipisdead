{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "2ccb840de076261467812cbc32f8aa47",
  "compatibility_date": "2026-10-06",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quipisdead-accounts",
      "database_id": "811a5945-5405-4c77-9c4a-0c42a468cd7a",
      "migrations_dir": "migrations"
    }
  ],
  "name": "quipisdead-capture",
  "main": "src/worker/capture/worker.ts",
  "workers_dev": false,
  "queues": {
    "consumers": [
      {
        "queue": "quipisdead-capture",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 5,
        "dead_letter_queue": "quipisdead-capture-failed"
      },
      {
        "queue": "quipisdead-capture-failed",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "retry_delay": 60
      }
    ]
  }
}
